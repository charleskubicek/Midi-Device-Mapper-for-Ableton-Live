# The launch_control's function/switch/nav buttons are configured as TOGGLE in
# Novation Components (one alternating 127/0 event per press). The hold-style
# shift button is separate (handled by the mode FSM) and stays momentary.
#button-behaviour: toggle

light_colors:
    off: 12
    red_low: 13
    green_full: 60



# Control groups are rows of controllers,

control_groups:

  # Each group contains one row or column of controllers and a range of MIDI CC numbers,
    -
        layout: grid
        number: 1
        type: button
        midi_channel: 1
        midi_type: note
        midi_range: C1-DS2
        rows: 4
        columns: 4
        # UNVERIFIED — inferred from grid-4, not measured. This block has never
        # been seen emitting a note. Press its physical top-left button and check
        # ./bin/tail_logs.sh: note 48 = correct as written; 51 = bottom-right;
        # 36 = no flip (drop this line); silence = the block is still on its old
        # 0-15 range in Grid Editor. See ai-coding/plans/grid-origin-plan.md.
        origin: bottom-left
    -
        layout: grid
        number: 2
        type: knob
        midi_channel: 1
        midi_type: CC
        midi_range: 16-31
        rows: 4
        columns: 4
        right_of: 1
    -
        layout: grid
        number: 3
        type: knob
        midi_channel: 1
        midi_type: CC
        midi_range: 32-47
        rows: 4
        columns: 4
        right_of: 2
    -
        layout: grid
        number: 4
        type: button
        midi_channel: 1
        midi_type: note
        midi_range: B2-D4
        rows: 4
        columns: 4
        right_of: 3
        # Verified on hardware: the physical top-left button of this block emits
        # note 71, which is B2+12 — i.e. counting starts at the bottom-left.
        origin: bottom-left

# Cosmetic HUD divider (hud_dividers plan): a single vertical rule between the
# two PO16 synth banks — grid-1/grid-2 on the left, grid-3/grid-4 on the right.
dividers:
    -
        a: grid-2
        b: grid-3